# Publish only the selected public repository content from this workspace.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/install.sh
!/verl/
!/vllm
!/vllm-ascend
!/sglang-dflash/
!/diffusion/
!/fig/
!/data/
/fig/*
!/fig/overview-draft-opd.jpg

# Ignore top-level workspace scripts; child repository files are unaffected.
/*.py
/install-local.sh
/.nested-git-backups/

# In the OPD trainer examples, publish only the two reusable entrypoints.
/verl/examples/on_policy_distillation_trainer/*
!/verl/examples/on_policy_distillation_trainer/run_qwen_gsm8k.sh
!/verl/examples/on_policy_distillation_trainer/run_qwen_gsm8k_forward-ins.sh
!/verl/examples/on_policy_distillation_trainer/run_qwen-30b-a3b.sh
!/verl/examples/on_policy_distillation_trainer/run_qwen_gsm8k_vllm_npu.sh
# Local experiment notes and one-off conversion wrappers contain machine paths.
/verl/change-by-codex.md
/verl/my-purpose.md
/verl/scripts/fsdp_to_eagle3.sh
/verl/scripts/extract_eagle3_draft_from_fsdp.py
/verl/verl/models/transformers/eagle3_student.py
